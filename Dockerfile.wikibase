FROM wikibase/wikibase:mw1.45.0

WORKDIR /var/www/html

COPY php/uploads.ini /usr/local/etc/php/conf.d/zz-uploads.ini

# Install ProfessionalWiki SPARQL extension via git clone.
# The extension has no external PHP library dependencies (only composer/installers
# which is already in vendor/), so extension.json + wfLoadExtension handles everything.
# See: https://www.mediawiki.org/wiki/Extension:SPARQL
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* \
 && git clone --depth 1 https://github.com/ProfessionalWiki/SPARQL.git /var/www/html/extensions/SPARQL
