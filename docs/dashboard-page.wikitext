<script>
(function () {
  'use strict';
  var EP = 'https://dev-climatekg.semanticclimate.org/query/proxy/sparql';

  function ready(id) {
    var el = document.getElementById('ckg-c-' + id);
    if (el) el.classList.remove('ckg-loading');
  }
  function err(id) {
    var el = document.getElementById('ckg-c-' + id);
    if (el) { el.classList.remove('ckg-loading'); el.classList.add('ckg-err'); }
  }
  function set(id, val) {
    var el = document.getElementById('ckg-v-' + id);
    if (el) el.textContent = val;
  }
  function sparql(q, cb) {
    fetch(EP + '?query=' + encodeURIComponent(q) + '&format=json', {
      headers: { 'Accept': 'application/sparql-results+json' }
    })
    .then(function (r) { return r.json(); })
    .then(function (d) { cb(null, d); })
    .catch(function (e) { cb(e, null); });
  }

  // Items + Statements
  sparql(
    'SELECT (COUNT(DISTINCT ?item) AS ?items) (SUM(?stmts) AS ?stmts) ' +
    'WHERE { ?item wikibase:statements ?stmts . }',
    function (e, d) {
      if (e || !d) { err('items'); err('stmts'); return; }
      var b = d.results.bindings[0] || {};
      set('items', parseInt(b.items && b.items.value || 0, 10).toLocaleString());
      set('stmts', parseInt(b.stmts && b.stmts.value || 0, 10).toLocaleString());
      ready('items'); ready('stmts');
    }
  );

  // Properties
  sparql(
    'SELECT (COUNT(?p) AS ?count) WHERE { ?p a wikibase:Property . }',
    function (e, d) {
      if (e || !d) { err('props'); return; }
      var b = d.results.bindings[0] || {};
      set('props', parseInt(b.count && b.count.value || 0, 10).toLocaleString());
      ready('props');
    }
  );

  // Last modified
  sparql(
    'SELECT ?dt WHERE { ' +
    '?item schema:dateModified ?dt . ' +
    'FILTER(STRSTARTS(STR(?item), "https://dev-climatekg.semanticclimate.org/entity/Q")) ' +
    '} ORDER BY DESC(?dt) LIMIT 1',
    function (e, d) {
      if (e || !d || !d.results.bindings.length) { set('mod', '—'); ready('mod'); return; }
      var v = d.results.bindings[0].dt.value;
      set('mod', v.substring(0, 10));
      ready('mod');
    }
  );
}());
</script>

