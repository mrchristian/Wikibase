= ClimateKG — Data Dashboard =
<div id="ckg-intro" style="color:#555;font-size:1.05em;margin-bottom:1.5em;line-height:1.6;">
Live overview of the <b>ClimateKG</b> knowledge graph. Statistics and tables are populated directly from the <a href="https://dev-climatekg.semanticclimate.org/query/">SPARQL endpoint</a>. Requires JavaScript.
</div>

<html>
<style>
/* ── ClimateKG Dashboard ── */
.ckg { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.ckg-stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 16px;
  margin: 1.2em 0 2em;
}
.ckg-stat {
  background: linear-gradient(140deg, #1e5f8e 0%, #2d8dd4 100%);
  border-radius: 10px;
  padding: 22px 18px 16px;
  color: #fff;
  text-align: center;
  box-shadow: 0 3px 10px rgba(30,95,142,.25);
  transition: transform .15s;
}
.ckg-stat:hover { transform: translateY(-2px); }
.ckg-stat .sv { font-size: 2.4em; font-weight: 700; line-height: 1.1; min-height: 1.1em; }
.ckg-stat .sl { font-size: .8em; opacity: .82; margin-top: 5px; text-transform: uppercase; letter-spacing: .07em; }
.ckg-stat .sa { display: inline-block; margin-top: 10px; padding: 3px 11px; background: rgba(255,255,255,.2); border-radius: 4px; color: #fff; font-size: .78em; text-decoration: none; transition: background .15s; }
.ckg-stat .sa:hover { background: rgba(255,255,255,.35); }
@keyframes ckg-pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
.ckg-stat.ckg-loading .sv { animation: ckg-pulse 1.3s ease-in-out infinite; }
.ckg-stat.ckg-err { background: linear-gradient(140deg, #922b21 0%, #e74c3c 100%); }
.ckg-embed {
  border: 1px solid #dde3e8;
  border-radius: 8px;
  overflow: hidden;
  background: #f8f9fa;
  margin-bottom: 1.6em;
}
