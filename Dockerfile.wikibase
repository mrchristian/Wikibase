FROM wikibase/wikibase:mw1.45.0

WORKDIR /var/www/html

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY php/uploads.ini /usr/local/etc/php/conf.d/zz-uploads.ini

# Note: SPARQL extension installation temporarily disabled due to build issues
# Will re-enable after testing basic deployment
# See: https://www.mediawiki.org/wiki/Extension:SPARQL
