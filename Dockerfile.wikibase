FROM wikibase/wikibase:mw1.45.0

WORKDIR /var/www/html

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY php/uploads.ini /usr/local/etc/php/conf.d/zz-uploads.ini

# Install unzip (required for Composer to download zip distributions efficiently)
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*

# Install ProfessionalWiki SPARQL extension (professional-wiki/sparql)
# See: https://www.mediawiki.org/wiki/Extension:SPARQL
# The base image files are owned by nobody:nogroup; PHP's file_put_contents cannot
# overwrite them during build, but cp can. We route through /tmp to get root-owned
# writable copies of composer.json and composer.lock before running composer update.
RUN cp /var/www/html/composer.json /tmp/c.json \
 && python3 -c 'import json; d=json.load(open("/tmp/c.json")); d.setdefault("require",{})["professional-wiki/sparql"]="^1.0"; json.dump(d,open("/tmp/c.json","w"),indent=4)' \
 && cp /tmp/c.json /var/www/html/composer.json \
 && rm /var/www/html/composer.lock \
 && COMPOSER_ALLOW_SUPERUSER=1 composer update --working-dir /var/www/html \
    professional-wiki/sparql --no-interaction --no-progress
