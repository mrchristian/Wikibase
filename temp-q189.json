    "P33": [
      {
        "mainsnak": {
          "snaktype": "value",
          "property": "P33",
          "hash": "ab27492d2b2ba1e2694472d63e7364c4008a456c",
          "datavalue": {
            "value": "The Synthesis Report (SYR) is a stand-alone synthesis of the most policy-relevant evidence from the scientific, technical, and socio-economic literature assessed in the Sixth Assessment Report (AR6) of the Intergovernmental Panel on Climate Change (IPCC). The SYR distils and integrates the main findings of the three reports of the Working Groups of the IPCC during the AR6, and the three AR6 Special Reports into a concise document. It consists of a Summary for Policymakers and a longer report.",
            "type": "string"
          },
          "datatype": "string"
        },
